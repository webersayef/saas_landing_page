# Copy to .env.local for local dev / set in Vercel → Settings → Environment Variables
SESSION_SECRET=change-me-long-random-string
SUPER_ADMIN_PASSWORD=change-me-super-admin-password
CRON_SECRET=change-me-cron-secret
# App base URL (used for the Google OAuth redirect URI). Leave empty locally;
# on Vercel set it to the production URL, e.g. https://your-app.vercel.app
APP_URL=
# Production data backend (Supabase Postgres) — REQUIRED on Vercel so data persists.
# Without these two, the app falls back to the local JSON file store (local dev/tests only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional — real email sending (ভেরিফিকেশন কোড ও বিলিং ইমেইলের জন্য).
# Without RESEND_API_KEY, emails are queued in the email outbox only (কোড পাঠানো হবে না).
RESEND_API_KEY=
RESEND_FROM=Shera IT <noreply@example.com>
# Optional — Google login ("Google দিয়ে লগইন করুন" বাটন).
# Google Cloud Console → OAuth 2.0 Client ID তৈরি করে বসান; Authorized redirect URI:
#   <APP_URL>/api/auth/google/callback
# দুটো না বসালে Google বাটন দেখাবে না, ইমেইল-পাসওয়ার্ড লগইন চলবে।
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — override the local JSON store path (tests use this)
SAAS_STORE_PATH=
