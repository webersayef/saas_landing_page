# Copy to .env.local for local dev / set in Vercel → Settings → Environment Variables
SESSION_SECRET=change-me-long-random-string
SUPER_ADMIN_PASSWORD=change-me-super-admin-password
CRON_SECRET=change-me-cron-secret
# Production data backend (Supabase Postgres) — REQUIRED on Vercel so data persists.
# Without these two, the app falls back to the local JSON file store (local dev/tests only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional — real email sending. Without it, emails are queued in the email outbox only.
RESEND_API_KEY=
RESEND_FROM=Shera IT <noreply@example.com>
# Optional — override the local JSON store path (tests use this)
SAAS_STORE_PATH=
